{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madrix01/tabby/critter_payload.schema.json",
  "title": "Critter payloads (generated by compiler/compile.mjs; do not edit by hand)",
  "catalogVersion": 2,
