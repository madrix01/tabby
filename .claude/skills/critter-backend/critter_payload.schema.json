    "item": {
      "type": "object",
      "required": [
        "id",
        "slot"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "enum": [
            "hat",
            "eyes",
            "neck",
            "prop"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "slot": {
              "enum": [
                "hat",
                "neck",
                "prop"
              ]
            },
            "svg": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000,
              "description": "Shapes only: path, circle, ellipse, rect, polygon, polyline, line, g. Must not contain href, url(, style, <!, <?, javascript:. Use presentation attributes (fill=\"#…\") not style. Draw text as paths."
            },
            "anchor": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y] in the item drawing that lands on the character"
            },
            "fit": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 2,
              "default": 0.5,
              "description": "neck only: width as a fraction of the neck"
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 400,
              "default": 40,
              "description": "neck only: drawn height"
            }
          },
          "required": [
            "svg",
            "anchor"
          ]
        },
        {
          "properties": {
            "slot": {
              "const": "eyes"
            },
            "lens": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000,
              "description": "Shapes only: path, circle, ellipse, rect, polygon, polyline, line, g. Must not contain href, url(, style, <!, <?, javascript:. Use presentation attributes (fill=\"#…\") not style. Draw text as paths."
            },
            "lensRight": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000,
              "description": "Shapes only: path, circle, ellipse, rect, polygon, polyline, line, g. Must not contain href, url(, style, <!, <?, javascript:. Use presentation attributes (fill=\"#…\") not style. Draw text as paths."
            },
            "grow": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 3,
              "default": 1.15,
              "description": "Lens size vs eye"
            },
            "bridge": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "strap": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            }
          },
          "required": [
            "lens"
          ]
        }
      ]
    },
