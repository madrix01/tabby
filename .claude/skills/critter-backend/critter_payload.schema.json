        "dewdrop",
        "pea",
        "sandy",
        "tock",
        "stilts",
        "wiggle",
        "hexo",
        "pebblet",
        "drippy",
        "mound",
        "bean",
        "puffin",
        "speckle",
        "v6_bloop",
        "v6_mochi",
        "v6_puff",
        "v6_pup",
        "v6_berry",
        "v6_pickle",
        "v6_chiku",
        "v6_bun",
        "v6_cute_bloop",
        "v6_cute_mochi",
        "v6_cute_puff",
        "v6_cute_pup",
        "v6_cute_berry",
        "v6_cute_pickle",
        "v6_cute_chiku",
        "v6_cute_bun"
      ],
      "description": "45 species. v3 set: blip, totem, sprig, radish, pip, ember, pinky, bunbun, stamp, squidge, snowy, cactoo, drip, lemon, mochi, nimbo. v4 set: dewdrop, pea, sandy, tock, stilts, wiggle, hexo, pebblet, drippy, mound, bean, puffin, speckle. v6 frens: v6_bloop, v6_mochi, v6_puff, v6_pup, v6_berry, v6_pickle, v6_chiku, v6_bun, v6_cute_bloop, v6_cute_mochi, v6_cute_puff, v6_cute_pup, v6_cute_berry, v6_cute_pickle, v6_cute_chiku, v6_cute_bun. All sets can be mixed freely (e.g. a v3 critter sending money to a v4 one)."
    },
    "critterSpec": {
      "type": "object",
      "required": [
        "species"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "species": {
          "$ref": "#/$defs/species"
        },
        "form": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Evolution stage index within the species line."
        },
        "xp": {
          "type": "number",
          "minimum": 0,
          "description": "Optional. Only grows the critter inside its current form; does not change form."
        },
        "attachments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hat": {
              "type": "string",
              "minLength": 1,
              "description": "Bundled hat ids: top_hat, party, crown, cap, beanie, chef. Any other id must be defined in the spec's \"items\" (or registered with registerItems).",
              "examples": [
                "top_hat",
                "party",
                "crown",
                "cap",
                "beanie",
                "chef"
              ]
            },
            "eyes": {
              "type": "string",
              "minLength": 1,
              "description": "Bundled eyes ids: goggles, shades, round, three_d, hearts. Any other id must be defined in the spec's \"items\" (or registered with registerItems).",
              "examples": [
                "goggles",
                "shades",
                "round",
                "three_d",
                "hearts"
              ]
            },
            "neck": {
              "type": "string",
              "minLength": 1,
              "description": "Bundled neck ids: bow_tie, gold_chain, medal. Any other id must be defined in the spec's \"items\" (or registered with registerItems).",
              "examples": [
                "bow_tie",
                "gold_chain",
                "medal"
              ]
            },
            "prop": {
              "type": "string",
              "minLength": 1,
              "description": "Bundled prop ids: gold_bar, gold_stack, money_bag, coffee. Any other id must be defined in the spec's \"items\" (or registered with registerItems).",
              "examples": [
                "gold_bar",
                "gold_stack",
                "money_bag",
                "coffee"
              ]
            }
          }
        },
        "mood": {
          "enum": [
            "happy",
            "sad",
            "food",
            "entertainment",
            "travel",
            "shopping",
            "empty_wallet"
          ]
        },
        "look": {
          "enum": [
            "flat",
            "glow"
          ],
          "default": "flat"
        },
        "glow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "halo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.35,
              "description": "Halo opacity"
            },
            "blur": {
              "type": "number",
              "minimum": 0,
              "maximum": 3,
              "default": 0.8,
              "description": "Halo size"
            },
            "brightness": {
              "type": "number",
              "minimum": 1,
              "maximum": 2,
              "default": 1,
              "description": "Halo brightness (ignored with color)"
            },
            "shading": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5,
              "default": 1.5,
              "description": "Body shading"
            },
            "gloss": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5,
              "default": 0.45,
              "description": "Highlight + eye glints"
            },
            "shadow": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5,
              "default": 1.5,
              "description": "Contact shadow"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Tint the halo one colour"
            }
          }
        },
        "behaviour": {
          "type": "object",
          "properties": {
            "likesPets": {
              "type": "boolean",
              "default": true
            },
            "gait": {
              "type": "string",
              "default": "waddle"
            },
            "state": {
              "type": "string",
              "default": "idle"
            }
          },
          "description": "Reserved for the animation layer; carried through but not rendered yet."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "allOf": [
